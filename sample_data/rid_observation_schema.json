{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rid-fusion.local/schema/observation-v1.json",
  "title": "RID Fusion标准观测",
  "description": "RID Fusion Studio文件导入使用的规范化单条观测格式。",
  "type": "object",
  "required": ["uas_id", "protocol", "timestamp_utc", "lat_deg", "lon_deg"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "uas_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "protocol": {"type": "string", "enum": ["WIFI", "WIFI_BEACON", "BLE", "BLE_ADVB", "NR", "NR_BROADCAST", "LORA", "LORAWAN", "ADS_B"]},
    "timestamp_utc": {"type": "number"},
    "receive_timestamp_utc": {"type": "number"},
    "lat_deg": {"type": "number", "minimum": -90, "maximum": 90},
    "lon_deg": {"type": "number", "minimum": -180, "maximum": 180},
    "alt_m": {"type": ["number", "null"], "minimum": -500, "maximum": 10000},
    "vx_ms": {"type": ["number", "null"]},
    "vy_ms": {"type": ["number", "null"]},
    "vz_ms": {"type": ["number", "null"]},
    "rssi_dbm": {"type": ["number", "null"]},
    "snr_db": {"type": ["number", "null"]},
    "horizontal_variance_m2": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "vertical_variance_m2": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "velocity_variance_ms2": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "receiver_id": {"type": "string"},
    "transport_type": {"type": "string"}
  },
  "additionalProperties": true
}
